@page "/"
@inherits LiveComponentBase
@inject InsightsService Insights
@inject IClientCatalog Clients

<PageTitle>Dashboard · Tool Calls Inspector</PageTitle>

<div class="page-header">
    <div>
        <h1>Token dashboard</h1>
        <div class="subtitle">Where your Copilot tokens go — updated live as telemetry arrives.</div>
    </div>
    <div class="segmented">
        @foreach (var (label, range) in Ranges)
        {
            <button class="@(range == _range ? "active" : "")" @onclick="() => SetRangeAsync(range)">@label</button>
        }
    </div>
</div>

@if (Loading)
{
    <div class="muted">Loading…</div>
}
else if (_data is null || _data.Totals.LlmCalls == 0)
{
    <div class="panel empty">
        <h2>No telemetry yet</h2>
        <p>Point VS Code Copilot Chat's OpenTelemetry exporter at this inspector, or load demo data to explore.</p>
        <a class="btn primary" href="setup">Go to setup →</a>
    </div>
}
else
{
    var t = _data.Totals;
    <div class="grid kpis">
        <Kpi Label="Total tokens" Value="@Fmt.Tokens(t.Total)" Sub="@($"{Fmt.Exact(t.Total)} input + output")" />
        <Kpi Label="Input tokens" Value="@Fmt.Tokens(t.Input)" Sub="@($"{Fmt.Tokens(t.FreshInput)} fresh · {Fmt.Tokens(t.CacheRead)} cached")" />
        <Kpi Label="Output tokens" Value="@Fmt.Tokens(t.Output)" Sub="@(t.Reasoning > 0 ? $"{Fmt.Tokens(t.Reasoning)} reasoning" : "generated by the model")" />
        <Kpi Label="Cache hit rate" Value="@Fmt.Ratio(t.CacheHitRate)" Sub="of input served from prompt cache" />
        <Kpi Label="LLM calls" Value="@t.LlmCalls.ToString("N0")" Sub="@($"avg {Fmt.Tokens(t.LlmCalls > 0 ? t.Total / (double)t.LlmCalls : 0)} tokens/call")" />
        <Kpi Label="Tool calls" Value="@t.ToolCalls.ToString("N0")" Sub="@($"{t.ByTool.Count} distinct tools")" />
        <Kpi Label="Sessions" Value="@_data.Sessions.Count.ToString("N0")" Sub="@($"{_data.Sessions.Sum(s => s.InteractionCount)} interactions")" />
    </div>

    <div class="grid cols-2">
        <div class="panel">
            <h2>Where did the tokens go?</h2>
            <div class="muted" style="margin-bottom:.75rem;font-size:.85rem">
                Share of all tokens processed. Tool results and history are re-sent on every LLM call, so they usually dominate input.
            </div>
            <Donut Slices="_slices" CenterLabel="total tokens">
                <BreakdownTable Slices="_slices" ToolDetails="ToolConsumed(t)" />
            </Donut>
        </div>
        <div class="panel">
            <h2>LLM output vs. tool results</h2>
            @{
                var toolInput = t.InputByCategory.GetValueOrDefault(TokenCategory.ToolResults);
            }
            <div class="grid kpis" style="grid-template-columns:repeat(3,1fr)">
                <Kpi Label="LLM output" Value="@Fmt.Pct(Pct(t.Output, t.Total))" Sub="@Fmt.Tokens(t.Output)" />
                <Kpi Label="Tool results (input)" Value="@Fmt.Pct(Pct(toolInput, t.Total))" Sub="@Fmt.Tokens(toolInput)" />
                <Kpi Label="Other input" Value="@Fmt.Pct(Pct(t.Input - toolInput, t.Total))" Sub="@Fmt.Tokens(t.Input - toolInput)" />
            </div>
            <BreakdownBar Slices="_slices" ShowLegend="true" />

            <h3 style="margin-top:1.25rem">Top tools by tokens consumed</h3>
            <table class="data">
                <thead><tr><th>Tool</th><th class="num">Calls</th><th class="num">Introduced</th><th class="num">Consumed</th><th class="num">% of input</th></tr></thead>
                <tbody>
                    @foreach (var tool in t.ByTool.Values.OrderByDescending(x => x.ConsumedInputTokens).Take(8))
                    {
                        <tr>
                            <td class="mono">@tool.ToolName</td>
                            <td class="num">@tool.Calls</td>
                            <td class="num">@Fmt.Tokens(tool.IntroducedTokens)</td>
                            <td class="num">@Fmt.Tokens(tool.ConsumedInputTokens)</td>
                            <td class="num">@Fmt.Pct(Pct(tool.ConsumedInputTokens, t.Input))</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div style="margin-top:.5rem"><a href="tools">All tools →</a></div>
        </div>
    </div>

    <div class="grid cols-2">
        <div class="panel">
            <h2>By model</h2>
            <table class="data">
                <thead><tr><th>Model</th><th class="num">Calls</th><th class="num">Input</th><th class="num">Cached</th><th class="num">Output</th><th class="num">Share</th></tr></thead>
                <tbody>
                    @foreach (var (model, m) in t.ByModel.OrderByDescending(x => x.Value.Total))
                    {
                        <tr>
                            <td>@model</td>
                            <td class="num">@m.Calls</td>
                            <td class="num">@Fmt.Tokens(m.Input)</td>
                            <td class="num">@Fmt.Tokens(m.CacheRead)</td>
                            <td class="num">@Fmt.Tokens(m.Output)</td>
                            <td class="num">@Fmt.Pct(Pct(m.Total, t.Total))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="panel">
            <h2>By client</h2>
            <table class="data">
                <thead><tr><th>Client</th><th class="num">LLM calls</th><th class="num">Tool calls</th><th class="num">Tokens</th><th class="num">Share</th></tr></thead>
                <tbody>
                    @foreach (var (client, c) in _data.ByClient.OrderByDescending(x => x.Value.Total))
                    {
                        <tr>
                            <td>@Clients.GetDisplayName(client)</td>
                            <td class="num">@c.LlmCalls</td>
                            <td class="num">@c.ToolCalls</td>
                            <td class="num">@Fmt.Tokens(c.Total)</td>
                            <td class="num">@Fmt.Pct(Pct(c.Total, t.Total))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="panel">
        <h2>Recent sessions</h2>
        <SessionTable Sessions="_data.Sessions.Take(10).ToList()" />
        <div style="margin-top:.5rem"><a href="sessions">All sessions →</a></div>
    </div>
}

@code {
    private static readonly (string Label, TimeSpan? Range)[] Ranges =
    [
        ("24h", TimeSpan.FromHours(24)),
        ("7 days", TimeSpan.FromDays(7)),
        ("30 days", TimeSpan.FromDays(30)),
        ("All", null),
    ];

    private TimeSpan? _range = TimeSpan.FromDays(7);
    private GlobalInsights? _data;
    private IReadOnlyList<BreakdownSlice> _slices = [];

    protected override async Task LoadAsync()
    {
        _data = await Insights.GetGlobalAsync(_range is { } r ? DateTimeOffset.UtcNow - r : null);
        _slices = _data.Totals.Slices();
    }

    private async Task SetRangeAsync(TimeSpan? range)
    {
        _range = range;
        await ReloadAsync();
    }

    private static Dictionary<string, double> ToolConsumed(TokenTotals t) =>
        t.ByTool.Values.Where(x => x.ConsumedInputTokens > 0).ToDictionary(x => x.ToolName, x => x.ConsumedInputTokens);

    private static double Pct(double value, double total) => total > 0 ? value / total * 100 : 0;
}
